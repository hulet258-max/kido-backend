NODE_ENV=production
PORT=4000
DB_HOST=mgnot_kidodb
DB_PORT=5432
DB_NAME=kido
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=REPLACE_WITH_ADMIN_API_KEY
# Public HTTPS API connection: Easypanel forwards 443 to internal MinIO port 9000.
MINIO_ENDPOINT=mgnot-minio.v3rao3.easypanel.host
MINIO_PORT=443
MINIO_ACCESS_KEY=kido-storage-admin
MINIO_SECRET_KEY=REPLACE_WITH_THE_MINIO_ROOT_PASSWORD
MINIO_BUCKET=videos
MINIO_USE_SSL=true
# Use a public HTTPS domain routed to MinIO API port 9000, not console port 9001.
MINIO_PUBLIC_URL=https://mgnot-minio.v3rao3.easypanel.host
CACHE_REMOTE_MEDIA=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=500
